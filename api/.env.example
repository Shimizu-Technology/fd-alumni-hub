# Rails API local development
# Local development uses config/database.yml defaults. Set DATABASE_URL only for
# external/staging/production databases, not routine local test runs.
# DATABASE_URL=postgresql://localhost/fd_alumni_hub_api_development
# TEST_DATABASE_URL=postgresql://localhost/fd_alumni_hub_api_test

# Canonical public frontend site URL (single source of truth for the hub origin).
# Example for cutover: PUBLIC_SITE_URL=https://fd-alumni.shimizu-technology.com
PUBLIC_SITE_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS.
# Production fails closed unless ALLOWED_ORIGINS or PUBLIC_SITE_URL is set.
# Keep both the new subdomain and the Netlify origin during cutover:
# ALLOWED_ORIGINS=https://fd-alumni.shimizu-technology.com,https://fd-alumni-tourney.netlify.app
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Clerk admin auth (see docs/DOMAIN-AND-CLERK-SETUP.md for production setup).
# Set CLERK_ISSUER (e.g. https://clerk.fd-alumni.shimizu-technology.com) or
# CLERK_PUBLISHABLE_KEY (pk_live_...) so Rails derives the issuer and JWKS URL.
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=
CLERK_JWKS_URL=
# Comma-separated browser origins accepted in the Clerk JWT azp claim.
# Example: https://fd-alumni.shimizu-technology.com,https://fd-alumni-tourney.netlify.app
CLERK_AUTHORIZED_PARTIES=
# Optional when using a custom Clerk JWT template with an aud claim.
CLERK_AUDIENCE=
# Required for Clerk Backend API email fallback when JWT claims omit email (sk_live_... in prod).
CLERK_SECRET_KEY=

# Optional public S3 image uploads for admin media, article images, and sponsor logos.
# AWS_* aliases are also supported for compatibility with the Shimizu starter guide.
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN/custom domain. If blank, URLs use https://<bucket>.s3.<region>.amazonaws.com/<key>.
S3_PUBLIC_BASE_URL=
# Optional presigned POST size limit in bytes. Default: 10485760 (10MB).
S3_IMAGE_UPLOAD_MAX_BYTES=10485760

# Optional local seed helpers. These only run when explicitly set.
FD_SEED_DEMO=0
FD_ADMIN_EMAIL=

# HafaPass read-only public events integration (server-side cached)
HAFAPASS_API_BASE_URL=https://hafapass-api.onrender.com/api/v1
HAFAPASS_WEB_BASE_URL=https://hafapass.shimizu-technology.com
HAFAPASS_EVENTS_CACHE_TTL_SECONDS=300
