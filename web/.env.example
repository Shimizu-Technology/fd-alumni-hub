# Single site URL env var used for canonical/OG tags, JSON-LD, robots.txt, and sitemap.xml.
# Production cutover target: https://fd-alumni.shimizu-technology.com
VITE_SITE_URL=http://localhost:5173

# Rails API base. Include /api/v1.
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Clerk auth for admin routes.
# Production must use a pk_live_... key from the production Clerk instance for
# fd-alumni.shimizu-technology.com (see docs/DOMAIN-AND-CLERK-SETUP.md).
VITE_CLERK_PUBLISHABLE_KEY=
# Optional custom JWT template. Leave blank when using the default Clerk session token
# plus Rails CLERK_SECRET_KEY email fallback.
VITE_CLERK_JWT_TEMPLATE=

# Partner fallback links.
VITE_GUAMTIME_URL=https://guamtime.net
VITE_CLUTCH_URL=https://www.clutchguam.com

# Optional PostHog analytics/session replay. Disabled unless key is present.
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Set to true only when testing analytics locally.
VITE_ENABLE_ANALYTICS_IN_DEV=false
